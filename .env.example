# Copy to .env and fill in. Mock mode works with empty live-CDP values.

# local | live
GATEWAY_MODE=local

# Host port for APISIX
APISIX_PORT=9080

# Operator admin UI (localhost only; not an agent route)
ADMIN_PORT=9090
ADMIN_INTERNAL_TOKEN=lab-admin

# Knox JWT claims
KNOX_ISSUER=KNOXSSO
KNOX_EXPECTED_ALG=RS256
KNOX_CLOCK_SKEW=60

# Burst cap on /mcp/spark, keyed by Knox sub (X-Knox-User). Not a daily quota.
MCP_RATE_COUNT=60
MCP_RATE_WINDOW=60

# Path prefix Knox uses for token-auth topologies.
# Private Cloud often: /gateway/cdp-proxy-token
# Public Cloud often:  /<env>/cdp-proxy-token
KNOX_PROXY_PREFIX=/gateway/cdp-proxy-token

# --- local mock (default) ---
UPSTREAM_SCHEME=http
UPSTREAM_HOST=mock-cdp
UPSTREAM_PORT=8080
UPSTREAM_TLS_VERIFY=false

# --- live CDP (make live) ---
# GATEWAY_MODE=live
# UPSTREAM_SCHEME=https
# UPSTREAM_HOST=knox.example.cloudera.site
# UPSTREAM_PORT=443
# UPSTREAM_TLS_VERIFY=false
# KNOX_JWKS_URL=https://knox.example.cloudera.site/gateway/homepage/knoxtoken/api/v1/jwks.json
# KNOX_PROXY_URL=https://knox.example.cloudera.site/env/cdp-proxy-token/livy_for_spark3
# KNOX_SERVICE_PATH=/livy_for_spark3
# KNOX_SERVICES=/livy_for_spark3
# KNOX_TOKEN=eyJ...

# Hive JDBC (gateway jdbc add). Inventoried only; /cdp/hive stays unpublished.
# HIVE_JDBC_URL=jdbc:hive2://knox.example.cloudera.site/;ssl=true;transportMode=http;httpPath=env/cdp-proxy-api/hive
# HIVE_KNOX_URL=https://knox.example.cloudera.site/env/cdp-proxy-api/hive
# HIVE_KNOX_PREFIX=/env/cdp-proxy-api
# HIVE_KNOX_TOPOLOGY=cdp-proxy-api
# HIVE_KNOX_SERVICE=/hive

# Optional CA bundle mounted into APISIX for UPSTREAM_TLS_VERIFY=true
# KNOX_CA_FILE=./secrets/cdp-ca.pem

# --- optional Cloudera AI AMP (CML project env, not this file) ---
# See docs/amp.md. Required there: KNOX_PROXY_URL. Do not put KNOX_TOKEN in AMP project env.
